{
  // Configuración del Worker comunidad-mvp (producción ya creada).
  // El entry es worker-entry.mjs: envuelve el handler de Nitro para
  // exportar la clase Durable Object RealtimeRoom (Fase 3) e interceptar
  // los upgrades WebSocket de /api/rt/*. Los assets salen de .output/public.
  "name": "comunidad-mvp",
  "workers_dev": true,
  "main": "worker-entry.mjs",
  "compatibility_date": "2025-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": { "directory": ".output/public", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "comunidad-db",
      "database_id": "cb011827-2fb2-4927-b821-1eab1d81d138"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "comunidad-files"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "REALTIME", "class_name": "RealtimeRoom" }
    ]
  },
  // OBLIGATORIO al desplegar la Fase 3: esta migración registra la clase
  // del Durable Object. Sin aplicarla, Cloudflare rechaza el deploy.
  "migrations": [
    { "tag": "v1-realtime", "new_sqlite_classes": ["RealtimeRoom"] }
  ],
  "vars": {
    "NUXT_PUBLIC_APP_NAME": "ServGT",
    "NUXT_COMMUNITY_BASE_DOMAIN": "servgt.me",
    "NUXT_COMMUNITY_CREATION_ENABLED": "false"
  }
  // El secreto de sesión NO va aquí: `wrangler secret put NUXT_SESSION_SECRET`
}
